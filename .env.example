# Anthropic API key for LLM enrichment (optional)
# ANTHROPIC_API_KEY=sk-ant-...

# LLM enrichment level: none, low, or regular
# - none: regex only (default, no API key needed)
# - low: phase classification + severity enrichment
# - regular: full enrichment (phases, severity, actions, entities)
# LLM_ENRICHMENT=none
